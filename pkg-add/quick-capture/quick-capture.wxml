<view class="page capture-page">
  <view class="capture-card">
    <view class="capture-head">
      <text class="capture-icon" aria-hidden="true">📷</text>
      <text class="capture-title">一图一件快速录入</text>
      <text class="capture-desc">先在本地预览，只选一件食材、一个包装或一张标签。</text>
    </view>

    <view class="privacy-note">
      <text class="privacy-title">图片默认不保留</text>
      <text class="privacy-copy">只有你点击确认后才会进入临时图片会话；识别结果只作为候选，仍需在下一页逐项确认。</text>
    </view>

    <view wx:if="{{!previewPath}}" class="choice-list">
      <button class="capture-button primary" loading="{{choosing}}" bindtap="handleTakePhoto">
        拍一张照片
      </button>
      <button class="capture-button secondary" loading="{{choosing}}" bindtap="handleChooseAlbum">
        从相册选择
      </button>
    </view>

    <view wx:else class="preview-panel">
      <image class="preview-image" src="{{previewPath}}" mode="aspectFit" aria-label="待确认的食材照片预览" />
      <text class="local-badge">
        {{state === 'uploading' ? '临时处理进行中' : '本地预览 · 尚未上传'}}
      </text>

      <view class="preview-actions">
        <button class="mini-button" loading="{{choosing}}" bindtap="handleTakePhoto">重拍</button>
        <button class="mini-button" loading="{{choosing}}" bindtap="handleChooseAlbum">换图</button>
      </view>

      <button
        wx:if="{{state !== 'blocked'}}"
        class="capture-button primary confirm-button"
        loading="{{processing}}"
        disabled="{{processing}}"
        bindtap="handleConfirmUpload"
      >
        确认上传并识别
      </button>
    </view>

    <view wx:if="{{boundaryMessage}}" class="boundary-card" aria-role="alert">
      <text class="boundary-title">正式入口仍关闭</text>
      <text class="boundary-copy">{{boundaryMessage}}</text>
      <button class="capture-button primary" bindtap="handleManualFallback">转手动填写</button>
    </view>

    <text wx:if="{{errorMessage}}" class="error-message" aria-role="alert">{{errorMessage}}</text>
    <text wx:if="{{progressMessage}}" class="progress-message">{{progressMessage}}</text>
    <text wx:if="{{cleanupPending}}" class="cleanup-message" aria-role="alert">
      临时图片清理尚未确认，服务端会话保留可重试状态。
    </text>

    <view class="footer-actions">
      <button wx:if="{{previewPath && state !== 'blocked'}}" class="text-button" bindtap="handleManualFallback">
        不用照片，手动填写
      </button>
      <button class="text-button muted" bindtap="handleCancel">取消本次录入</button>
    </view>
  </view>
</view>

<view class="page form-page">
  <view class="form-card">
    <view wx:if="{{entryNotice}}" class="entry-notice" aria-role="alert">
      <text class="entry-notice-title">请核对录入信息</text>
      <text class="entry-notice-copy">{{entryNotice}}</text>
    </view>

    <view class="field">
      <text class="field-label">食品名称</text>
      <input
        class="native-input"
        value="{{form.name}}"
        placeholder="例如：牛奶、鸡蛋、菠菜，也可输 nn / jd"
        aria-label="食品名称"
        maxlength="30"
        bindinput="handleNameInput"
      />
      <view wx:if="{{lexiconHint}}" class="lexicon-hint">
        <text>{{lexiconHint}}，保存前可手动修改。</text>
      </view>
      <view wx:if="{{!isEdit && recentFoods.length > 0}}" class="recent-panel">
        <view class="recent-head">
          <text class="recent-title">最近常加</text>
          <text class="recent-sub">点一下再加一次</text>
        </view>
        <scroll-view class="recent-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="recent-track">
            <view
              wx:for="{{recentFoods}}"
              wx:key="key"
              class="recent-chip"
              data-index="{{index}}"
              bindtap="handleRecentTap"
              aria-role="button"
            >
              <text class="recent-name">{{item.name}}</text>
              <text class="recent-meta">{{item.meta}}</text>
            </view>
          </view>
        </scroll-view>
      </view>
      <text wx:if="{{errors.name}}" class="field-error" aria-role="alert">{{errors.name}}</text>
    </view>

    <view class="field">
      <text class="field-label">品类</text>
      <view class="chip-row">
        <view
          wx:for="{{categoryOptions}}"
          wx:key="*this"
          class="chip {{form.category === item ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="handleCategoryTap"
          aria-role="button"
        >{{item}}</view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">存放分区</text>
      <view class="chip-row">
        <view
          wx:for="{{locationOptions}}"
          wx:key="*this"
          class="chip {{form.storageLocation === item ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="handleLocationTap"
          aria-role="button"
        >{{item}}</view>
      </view>
      <view wx:if="{{showLocationRecommend}}" class="recommend">
        <text class="recommend-text">推荐放「{{recommendedStorageLocation}}」（当前：{{form.storageLocation}}）</text>
        <button class="native-button native-button-small" bindtap="handleApplyRecommendedLocation">采纳</button>
      </view>
    </view>

    <view class="field quantity-field">
      <view class="quantity-switch-row">
        <view class="quantity-copy">
          <text class="field-label quantity-label">记录数量</text>
          <text class="field-help">关闭时只记录冰箱里有没有这项食材</text>
        </view>
        <switch
          checked="{{form.quantityTracked}}"
          color="#28b978"
          bindchange="handleQuantityTrackedChange"
          aria-label="是否记录数量"
        />
      </view>
      <view wx:if="{{form.quantityTracked}}" class="quantity-input">
        <input
          class="native-input"
          type="number"
          value="{{form.quantity}}"
          placeholder="请输入数量"
          aria-label="食材数量"
          bindinput="handleQuantityInput"
        />
        <text class="quantity-preview">首页显示为 ×{{form.quantity || 1}}</text>
      </view>
      <text wx:if="{{errors.quantity}}" class="field-error" aria-role="alert">{{errors.quantity}}</text>
    </view>

    <view class="field">
      <text class="field-label">过期日期</text>
      <view class="seg">
        <view class="seg-item {{dateMode === 'production' ? 'active' : ''}}" data-mode="production" bindtap="handleDateModeTap" aria-role="button">生产日 + 保质期</view>
        <view class="seg-item {{dateMode === 'expire' ? 'active' : ''}}" data-mode="expire" bindtap="handleDateModeTap" aria-role="button">直接选过期日</view>
      </view>

      <block wx:if="{{dateMode === 'production'}}">
        <picker
          mode="date"
          value="{{form.productionDate || today}}"
          start="2018-01-01"
          end="2035-12-31"
          data-target="production"
          bindchange="handleDateConfirm"
          aria-label="选择生产日期"
        >
          <view class="date-cell">
            <text class="date-cell-title">生产日期</text>
            <view class="date-cell-value">
              <text>{{form.productionDate || '点此选择'}}</text>
              <text class="date-cell-arrow">›</text>
            </view>
          </view>
        </picker>
        <view class="shelf-input">
          <input
            class="native-input"
            type="number"
            value="{{form.shelfLifeDays}}"
            placeholder="保质期天数，例如 7 / 30 / 180"
            aria-label="保质期天数"
            bindinput="handleShelfLifeInput"
          />
        </view>
        <text class="date-result {{form.expireDate ? 'active' : ''}}">{{form.productionDate && form.shelfLifeDays && form.expireDate ? '自动生成过期日：' + form.expireDate : '填写后自动生成过期日'}}</text>
        <text wx:if="{{errors.productionDate}}" class="field-error" aria-role="alert">{{errors.productionDate}}</text>
        <text wx:if="{{errors.shelfLifeDays}}" class="field-error" aria-role="alert">{{errors.shelfLifeDays}}</text>
      </block>

      <block wx:else>
        <picker
          mode="date"
          value="{{form.expireDate || today}}"
          start="2018-01-01"
          end="2035-12-31"
          data-target="expire"
          bindchange="handleDateConfirm"
          aria-label="选择过期日期"
        >
          <view class="date-cell">
            <text class="date-cell-title">过期日期</text>
            <view class="date-cell-value">
              <text>{{form.expireDate || '点此选择'}}</text>
              <text class="date-cell-arrow">›</text>
            </view>
          </view>
        </picker>
      </block>

      <text wx:if="{{errors.expireDate}}" class="field-error" aria-role="alert">{{errors.expireDate}}</text>
    </view>

    <view class="field">
      <text class="field-label">备注</text>
      <textarea
        class="native-textarea"
        value="{{form.note}}"
        placeholder="例如：开封后尽快吃完"
        aria-label="备注"
        maxlength="100"
        bindinput="handleNoteInput"
      />
    </view>

    <button class="native-button submit-btn {{saving ? 'native-button-disabled' : ''}}" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSubmit">
      {{isEdit ? '保存修改' : '保存食品'}}
    </button>
  </view>
</view>

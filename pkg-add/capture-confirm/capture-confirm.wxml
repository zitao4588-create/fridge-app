<view class="page confirm-page">
  <view class="confirm-card">
    <view class="confirm-head">
      <text class="confirm-title">核对识别候选</text>
      <text class="confirm-desc">图片只提供候选。请逐项核对，保存库存前不会自动采用。</text>
    </view>

    <image
      wx:if="{{previewPath}}"
      class="preview-image"
      src="{{previewPath}}"
      mode="aspectFit"
      aria-label="本次识别图片预览"
    />

    <view wx:if="{{warnings.length}}" class="warning-card {{attentionLevel === 'critical' ? 'critical' : ''}}" aria-role="alert">
      <text class="warning-title">
        {{attentionLevel === 'critical' ? '日期存在冲突，禁止自动采用' : '这些字段需要重点核对'}}
      </text>
      <text wx:for="{{warnings}}" wx:key="code" class="warning-copy">• {{item.message}}</text>
    </view>

    <view class="field-group">
      <text class="field-label">食材名称</text>
      <input class="field-input" value="{{form.name}}" maxlength="30" placeholder="请确认名称" bindinput="handleNameInput" />
    </view>

    <view class="field-grid">
      <picker mode="selector" range="{{categoryOptions}}" bindchange="handleCategoryChange">
        <view class="picker-field">
          <text class="field-label">品类</text>
          <text class="picker-value">{{form.category}}</text>
        </view>
      </picker>
      <picker mode="selector" range="{{locationOptions}}" bindchange="handleLocationChange">
        <view class="picker-field">
          <text class="field-label">存放分区</text>
          <text class="picker-value">{{form.storageLocation}}</text>
        </view>
      </picker>
    </view>

    <view class="switch-row">
      <view>
        <text class="field-label">记录数量</text>
        <text class="field-help">数量也是不可信候选</text>
      </view>
      <switch checked="{{form.quantityTracked}}" color="#28b978" bindchange="handleQuantityTracked" />
    </view>
    <view wx:if="{{form.quantityTracked}}" class="field-group">
      <text class="field-label">数量</text>
      <input class="field-input" type="number" value="{{form.quantity}}" bindinput="handleQuantityInput" />
    </view>

    <view wx:if="{{dateCandidates.length}}" class="candidate-list">
      <text class="field-label">识别到的日期候选</text>
      <view wx:for="{{dateCandidates}}" wx:key="key" class="candidate-chip {{item.critical ? 'critical' : ''}}">
        <text>{{item.label}}：{{item.value}}</text>
        <text>{{item.status}}</text>
      </view>
    </view>

    <view class="field-grid">
      <picker mode="date" value="{{form.productionDate}}" bindchange="handleProductionDateChange">
        <view class="picker-field">
          <text class="field-label">生产日期</text>
          <text class="picker-value">{{form.productionDate || '手动选择'}}</text>
        </view>
      </picker>
      <picker mode="date" value="{{form.expireDate}}" bindchange="handleExpireDateChange">
        <view class="picker-field required">
          <text class="field-label">过期日期</text>
          <text class="picker-value">{{form.expireDate || '必须确认'}}</text>
        </view>
      </picker>
    </view>

    <view class="retain-card">
      <view class="retain-copy">
        <text class="field-label">保存时保留照片</text>
        <text class="field-help">默认关闭。关闭后会精确清理本次临时云文件。</text>
      </view>
      <switch checked="{{retainImage}}" color="#28b978" bindchange="handleRetainImage" />
    </view>

    <text wx:if="{{cleanupPending}}" class="cleanup-note" aria-role="alert">
      临时图片尚未确认清理完成。请重试刚才的操作；也可先转手动填写，服务端会按到期规则继续清理。
    </text>
    <text wx:if="{{errorMessage}}" class="error-message" aria-role="alert">{{errorMessage}}</text>

    <button class="primary-button" loading="{{cleaning}}" bindtap="handleContinue">
      确认候选，继续填写
    </button>
    <button class="text-button" bindtap="handleManualFallback">放弃候选，转手动填写</button>
    <button
      wx:if="{{cleanupPending}}"
      class="text-button warning"
      bindtap="handleManualWithPendingCleanup"
    >
      临时图待清理，仍转手动填写
    </button>
    <button class="text-button muted" bindtap="handleCancel">取消本次录入</button>
  </view>
</view>

.features-page {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.features-hero,
.feature-card,
.features-footer {
  border-radius: 30rpx;
  background: var(--grad-card);
  box-shadow: var(--shadow-1), var(--hi-inset);
}

.features-hero {
  padding: 32rpx 28rpx;
  background: var(--grad-hero);
}

.features-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-main, #253730);
}

.features-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-sub, #5c6a62);
}

.feature-card {
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
}

.feature-name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--brand-mint-deep, #087a49);
}

.feature-label {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--text-main, #253730);
}

.feature-text {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-sub, #5c6a62);
}

.features-footer {
  min-height: 72rpx;
  margin-top: 22rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #ffffff;
  background: var(--brand-mint-deep, #087a49);
}

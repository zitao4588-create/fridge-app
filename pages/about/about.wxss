.about-page {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.about-hero,
.info-card,
.feedback-card,
.action-list {
  border-radius: 30rpx;
  background: var(--grad-card);
  box-shadow: var(--shadow-1), var(--hi-inset);
}

.about-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx 32rpx;
  text-align: center;
}

.about-mascot {
  width: 140rpx;
  height: 140rpx;
  filter: drop-shadow(0 8rpx 14rpx rgba(40, 120, 80, 0.18));
}

.about-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-main, #253730);
}

.about-subtitle {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 800;
  color: var(--brand-mint-deep, #087a49);
}

.about-desc {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.68;
  color: var(--text-sub, #5c6a62);
}

.info-card,
.feedback-card {
  margin-top: 22rpx;
  padding: 26rpx 24rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-main, #253730);
}

.card-text,
.fact-item {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.68;
  color: var(--text-sub, #5c6a62);
}

.fact-list {
  margin-top: 4rpx;
}

.feedback-text,
.feedback-privacy {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.68;
  color: var(--text-sub, #5c6a62);
}

.feedback-privacy {
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  color: var(--coral-deep, #b3392f);
  background: var(--coral-bg, #ffece6);
}

.feedback-button {
  width: 100% !important;
  min-height: 76rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 18rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #ffffff;
  background: var(--brand-mint-deep, #087a49);
}

.feedback-button::after {
  border: 0;
}

.action-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 18rpx;
}

.action-item {
  min-height: 68rpx;
  border-radius: 18rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--brand-mint-deep, #087a49);
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid rgba(8, 122, 73, 0.18);
}

.data-page { padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); }
.data-card { margin-bottom: 22rpx; padding: 28rpx 24rpx; border-radius: 30rpx; background: var(--grad-card); box-shadow: var(--shadow-1), var(--hi-inset); }
.data-title { display: block; font-size: 30rpx; font-weight: 800; color: var(--text-main, #253730); }
.data-copy { display: block; margin-top: 16rpx; font-size: 25rpx; line-height: 1.7; color: var(--text-sub, #5c6a62); }
.data-scope { display: block; margin-top: 20rpx; font-size: 27rpx; font-weight: 800; color: var(--brand-mint-deep, #087a49); }
.data-danger, .data-retry { width: 100% !important; margin: 24rpx 0 0; padding: 0 24rpx; border: 0; min-height: 84rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; line-height: 1.2; font-size: 27rpx; font-weight: 800; }
.data-danger { background: var(--coral-bg, #ffece6); color: var(--coral-deep, #b3392f); }
.data-retry { background: var(--brand-mint-deep, #087a49); color: #ffffff; }

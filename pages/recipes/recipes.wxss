.recipes-page {
  padding: 24rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));
}

.coming-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 36rpx;
  background: var(--grad-hero);
  box-shadow: var(--shadow-1), var(--hi-inset);
  overflow: hidden;
}

.coming-spark {
  position: absolute;
  width: 46rpx;
  height: 46rpx;
  opacity: 0.9;
}

.coming-spark.spark-a {
  top: 28rpx;
  right: 34rpx;
}

.coming-spark.spark-b {
  top: 96rpx;
  left: 40rpx;
  width: 32rpx;
  height: 32rpx;
  opacity: 0.7;
}

.coming-leaf {
  position: absolute;
  right: -10rpx;
  bottom: -10rpx;
  width: 96rpx;
  height: 96rpx;
  opacity: 0.5;
}

.coming-mascot {
  width: 140rpx;
  height: 140rpx;
  filter: drop-shadow(0 8rpx 14rpx rgba(40, 120, 80, 0.18));
}

.coming-badge {
  margin-top: 12rpx;
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #ffffff;
  background: var(--grad-honey);
  box-shadow: var(--shadow-honey), var(--hi-inset);
}

.coming-title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-main, #253730);
}

.coming-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.65;
  text-align: center;
  color: var(--text-sub, #5c6a62);
}

.coming-list {
  width: 100%;
  margin-top: 22rpx;
  padding: 10rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: var(--shadow-1);
}

.coming-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  font-size: 25rpx;
  color: var(--text-main, #253730);
}

.coming-ic {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 14rpx;
  background: var(--brand-mint-soft, #eaf8ee);
}

.settings-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--grad-card);
  box-shadow: var(--shadow-1), var(--hi-inset);
}

.settings-title {
  display: block;
  font-size: 29rpx;
  font-weight: 800;
  color: var(--text-main, #253730);
}

.settings-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--text-sub, #5c6a62);
}

.settings-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.settings-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand-mint-deep, #087a49);
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(8, 122, 73, 0.18);
}

.settings-link.primary {
  grid-column: span 2;
  font-size: 26rpx;
  color: #ffffff;
  background: var(--brand-mint-deep, #087a49);
  border-color: transparent;
}

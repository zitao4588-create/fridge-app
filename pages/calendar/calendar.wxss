.calendar-page {
  padding: 20rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));
}

/* 月历卡片 */
.cal-card {
  padding: 22rpx 20rpx 22rpx;
  border-radius: 32rpx;
  background: var(--grad-card);
  box-shadow: var(--shadow-1), var(--hi-inset);
}

.month-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-nav {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 38rpx;
  color: var(--brand-mint-deep, #087a49);
  background: var(--brand-mint-soft, #eaf8ee);
  box-shadow: var(--shadow-1);
}

.month-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.month-title {
  font-size: 31rpx;
  font-weight: 800;
  color: var(--text-main, #253730);
}

.today-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brand-mint-deep, #087a49);
  background: var(--brand-mint-soft, #eaf8ee);
}

.week-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 16rpx;
}

.week-grid text {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light, #647264);
}

.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 6rpx;
}

.day-cell {
  position: relative;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-number {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: var(--text-main, #253730);
}

.day-cell.muted .day-number {
  color: #828d87;
}

.day-cell.today .day-number {
  line-height: 52rpx;
  border: 2rpx solid var(--brand-mint, #28b978);
  color: var(--brand-mint-deep, #087a49);
  font-weight: 700;
}

.day-cell.selected .day-number {
  border: none;
  line-height: 56rpx;
  color: #ffffff;
  background: var(--brand-mint-deep, #087a49);
}

.day-dot {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--honey, #ffb23e);
}

/* 统计卡（图标 + 大数字） */
.stat-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  background: var(--grad-card);
  box-shadow: var(--shadow-1), var(--hi-inset);
}

.stat-ic {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 16rpx;
  background: var(--brand-mint-soft, #eaf8ee);
}

.stat-card.warning .stat-ic {
  background: var(--honey-bg, #fff5dc);
}

.stat-card.danger .stat-ic {
  background: var(--coral-bg, #ffece6);
}

.stat-col {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.1;
  color: var(--brand-mint-deep, #087a49);
}

.stat-card.warning .stat-num {
  color: var(--honey-deep, #9a5a0e);
}

.stat-card.danger .stat-num {
  color: var(--coral-deep, #b3392f);
}

.stat-name {
  font-size: 22rpx;
  color: var(--text-sub, #5c6a62);
}

/* 选中日 */
.sel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 20rpx 4rpx 12rpx;
}

.sel-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-main, #253730);
}

.sel-count {
  font-size: 24rpx;
  color: var(--text-sub, #5c6a62);
}

.sel-empty {
  padding: 24rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light, #647264);
  border: 2rpx dashed var(--cream-line, #eadbc4);
  border-radius: 20rpx;
}

/* 开饭雷达（玻璃雷达屏） */
.meal-radar-card {
  position: relative;
  overflow: hidden;
  margin-top: 18rpx;
  padding: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  background: linear-gradient(180deg, var(--cream-surface, #fffef8) 0%, var(--cream-bg, #fff6e8) 100%);
  box-shadow: inset 0 6rpx 14rpx rgba(255, 255, 255, 0.92), 0 18rpx 42rpx rgba(135, 105, 64, 0.13);
}

.meal-radar-card::before {
  content: "";
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 16rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0));
}

.meal-radar-decor {
  position: absolute;
  z-index: 0;
  pointer-events: none;
}

.meal-radar-decor.sparkle {
  left: 28rpx;
  bottom: 28rpx;
  width: 34rpx;
  height: 34rpx;
  opacity: 0.72;
}

.meal-radar-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.meal-radar-title-wrap {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.meal-radar-mascot {
  width: 82rpx;
  height: 82rpx;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 26rpx;
  background: linear-gradient(180deg, #ffffff 0%, var(--ice-soft, #ddf4ff) 100%);
  box-shadow: 0 10rpx 22rpx rgba(46, 156, 200, 0.12);
}

.meal-radar-title {
  display: block;
  color: var(--text-main, #253730);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.15;
}

.meal-radar-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--text-sub, #5c6a62);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.25;
}

.meal-radar-console {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 236rpx minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
  align-items: stretch;
}

.meal-radar-screen {
  position: relative;
  min-height: 236rpx;
  overflow: hidden;
  border: 5rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 50% 42%, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0) 76rpx),
    linear-gradient(180deg, var(--ice-bg, #f2fbff) 0%, var(--ice-soft, #ddf4ff) 42%, var(--ice-mid, #a9ddf1) 100%);
  box-shadow:
    inset 0 8rpx 18rpx rgba(255, 255, 255, 0.96),
    inset 0 -16rpx 28rpx rgba(58, 175, 216, 0.12),
    var(--shadow-ice, 0 14rpx 30rpx rgba(58, 175, 216, 0.12));
}

.meal-radar-screen.high .radar-score-value { color: var(--ice-ink, #1f6d89); }
.meal-radar-screen.medium .radar-score-value { color: var(--honey-deep, #9a5a0e); }
.meal-radar-screen.low .radar-score-value { color: var(--coral-deep, #b3392f); }

.radar-orbit {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 2rpx solid rgba(56, 166, 215, 0.22);
  border-radius: 999rpx;
  transform: translate(-50%, -50%);
}

.orbit-one { width: 196rpx; height: 196rpx; }
.orbit-two { width: 138rpx; height: 138rpx; }
.orbit-three { width: 78rpx; height: 78rpx; }

.radar-sweep {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(46, 156, 200, 0) 0%, rgba(46, 156, 200, 0.9) 100%);
  transform-origin: 0 50%;
  animation: radarSweep 3.4s linear infinite;
}

.radar-sweep::after {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(46, 156, 200, 0.95);
  transform: translateY(-50%);
  box-shadow: 0 0 10rpx rgba(46, 156, 200, 0.6);
}

.radar-core {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  z-index: 1;
  padding: 16rpx 12rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  text-align: center;
  transform: translateY(-50%);
}

.radar-score-label {
  display: block;
  color: var(--ice-ink, #1f6d89);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
}

.radar-score-value {
  display: block;
  margin-top: 12rpx;
  color: var(--ice-ink, #1f6d89);
  font-size: 60rpx;
  font-weight: 800;
  line-height: 1;
}

@keyframes radarSweep {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .radar-sweep { animation: none; }
}

.meal-radar-explain {
  min-width: 0;
  padding: 18rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 4rpx 10rpx rgba(255, 255, 255, 0.9);
}

.meal-radar-verdict {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
}

.meal-radar-verdict.high { color: var(--brand-mint-deep, #087a49); }
.meal-radar-verdict.medium { color: var(--honey-deep, #9a5a0e); }
.meal-radar-verdict.low { color: var(--coral-deep, #b3392f); }

.meal-radar-ranges {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
}

.meal-radar-ranges text {
  display: block;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(245, 252, 255, 0.92);
  color: var(--text-sub, #5c6a62);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
  opacity: 0.55;
}

.meal-radar-ranges text.on {
  opacity: 1;
  background: #ffffff;
  color: var(--ice-ink, #1f6d89);
  box-shadow: var(--shadow-1);
}

.meal-radar-priority {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  background: linear-gradient(180deg, var(--honey-bg, #fff5dc) 0%, var(--honey-soft, #ffe7b2) 100%);
  box-shadow: var(--shadow-warning, 0 6rpx 14rpx rgba(255, 178, 62, 0.14));
}

.meal-radar-priority.empty {
  background: linear-gradient(180deg, #ffffff 0%, var(--cream-bg-2, #fffaf0) 100%);
  box-shadow: 0 8rpx 18rpx rgba(135, 105, 64, 0.08);
}

.meal-radar-priority-label {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--honey-deep, #9a5a0e);
  font-size: 22rpx;
  font-weight: 800;
}

.meal-radar-priority-chips {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.meal-radar-priority-chip {
  min-width: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
}

.meal-radar-priority-name {
  max-width: 156rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #8a520e;
  font-size: 22rpx;
  font-weight: 800;
}

.meal-radar-priority-empty {
  min-width: 0;
  color: var(--text-sub, #5c6a62);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
}

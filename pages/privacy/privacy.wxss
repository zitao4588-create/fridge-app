.privacy-page {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.privacy-hero,
.privacy-card {
  border-radius: 30rpx;
  background: var(--grad-card);
  box-shadow: var(--shadow-1), var(--hi-inset);
}

.privacy-hero {
  padding: 32rpx 28rpx;
  background: var(--grad-hero);
}

.privacy-title,
.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main, #253730);
}

.privacy-desc,
.card-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.72;
  color: var(--text-sub, #5c6a62);
}

.privacy-card {
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
}

.privacy-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
}

.privacy-btn {
  min-height: 68rpx;
  border-radius: 18rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--brand-mint-deep, #087a49);
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(8, 122, 73, 0.18);
}

.privacy-btn.primary {
  color: #ffffff;
  background: var(--brand-mint-deep, #087a49);
  border-color: transparent;
}
